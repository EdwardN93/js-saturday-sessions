{
  "compilerOptions": {
    "target": "ES6", // or ES2015 or higher
    "module": "ES6", // use ES modules
    "moduleResolution": "node", // helps with import paths
    "outDir": "./dist", // output folder
    "rootDir": "./src", // your source files
    "strict": true,
    "esModuleInterop": true
  }

  // "include": ["src/**/*"], // Include all files inside the src directory
  // "exclude": ["node_modules"] // Exclude the node_modules directory
}
